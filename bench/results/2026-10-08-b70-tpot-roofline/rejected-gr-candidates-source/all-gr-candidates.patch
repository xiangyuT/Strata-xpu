+__dpct_inline__ void gr_up_prepared_lo_simd16(GrMulti m) {
+    auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    auto& lo = *sycl::ext::oneapi::group_local_memory_for_overwrite<float[kFusedGrMaxT][LR]>(item.get_group());
+    auto& g = *sycl::ext::oneapi::group_local_memory_for_overwrite<float[kFusedGrMaxT][HC][UPM_COLS]>(item.get_group());
+    const int tid = item.get_local_id(2), lane = tid & 15, subgroup = tid >> 4;
+    const int d0 = item.get_group(2) * UPM_COLS, T = m.T;
+    for (int i = tid; i < T * LR; i += THREADS) lo[i / LR][i % LR] = m.a[i / LR].lo[i % LR];
+    item.barrier();
+    const auto sg = item.get_sub_group();
+    for (int r = subgroup; r < HC * UPM_COLS; r += THREADS / 16) {
+        const int c = r / UPM_COLS, dd = r % UPM_COLS, i = c * N + d0 + dd;
+        const auto* w4 = reinterpret_cast<const sycl::uint4*>(m.a[0].w_up + (size_t)i * LR);
+        const sycl::uint4 lower_weights = w4[lane], upper_weights = w4[16 + lane];
+        const sycl::uint4 tail = lane < 8 ? w4[32 + lane] : sycl::uint4(0);
+        float rv = 0, wn = 0, rsc = 0, bo = 0, ip = 0;
+        bool apply = false;
+        if (lane < T) {
+            const auto& a = m.a[lane];
+            rv = a.R[i]; wn = a.w_norm[i]; rsc = a.rs[c]; apply = a.apply;
+            if (apply) { bo = a.bo_prev[d0 + dd]; ip = a.inj_prev[c]; }
+        }
+        float mine = 0;
+        #pragma unroll
+        for (int k = 0; k < kFusedGrMaxT; ++k) {
+            if (k >= T) break;
+            // The old lower lane first adds its tail. The paired addition is
+            // exactly the old xor16 step; later xor steps keep the same order.
+            float lower = dot8(lower_weights, lo[k] + lane * 8);
+            if (lane < 8) lower += dot8(tail, lo[k] + (32 + lane) * 8);
+            const float upper = dot8(upper_weights, lo[k] + (16 + lane) * 8);
+            float acc = lower + upper;
+#pragma unroll
+            for (int offset = 8; offset > 0; offset >>= 1) acc += sycl::permute_group_by_xor(sg, acc, offset);
+            if (lane == k) mine = acc;
+        }
+        if (lane < T) {
+            if (apply) { rv = sycl::fma(bo, 2.0f * sigmoidf_(ip / (float)HC), rv); m.a[lane].R_out[i] = rv; }
+            g[lane][c][dd] = rv * wn * rsc * sigmoidf_(mine);
+        }
+    }
+    item.barrier();
+    for (int i = tid; i < T * UPM_COLS; i += THREADS) {
+        const int k = i / UPM_COLS, col = i % UPM_COLS;
+        float sum = 0;
+        for (int c = 0; c < HC; ++c) sum += g[k][c][col];
+        m.a[k].mixed[d0 + col] = sum / (float)HC;
+    }
+}
